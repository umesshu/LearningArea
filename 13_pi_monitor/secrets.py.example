# 複製這個檔案為 secrets.py 並填入實際值，secrets.py 不要 commit 進版控
#
# 兩台裝置各自的 Blynk Auth Token，用來打 Blynk HTTP API 查狀態，不是拿去控制：
#   BLYNK_TOKEN_GARAGE01 對應 10_GarageHomekit/secrets.h 裡的 BLYNK_AUTH_TOKEN
#   BLYNK_TOKEN_GARAGE02 對應 12_GarageBlynk/secrets.h   裡的 BLYNK_AUTH_TOKEN

BLYNK_TOKEN_GARAGE01 = "your_auth_token_for_garage01"
BLYNK_TOKEN_GARAGE02 = "your_auth_token_for_garage02"
