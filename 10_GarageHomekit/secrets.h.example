#pragma once

// 範本檔:複製一份改名為 secrets.h,填入自己的 WiFi 帳密後再燒錄。
// secrets.h 已被 .gitignore 排除,不會被 commit 上去。
#define WIFI_SSID      "你的WiFi名稱"
#define WIFI_PASSWORD  "你的WiFi密碼"

// Blynk(純粹用來回報監控資料,不是 HomeKit 控制的一部分):
// 這是「Garage HomeKit」這個新 Device 的 Token,跟 12_GarageBlynk 用的不是同一個,
// 在 Blynk Console 該 Device 的 Device Info 分頁可以找到。
#define BLYNK_TEMPLATE_ID   "your_template_id"
#define BLYNK_TEMPLATE_NAME "your_template_name"
#define BLYNK_AUTH_TOKEN    "your_auth_token"
